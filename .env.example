DATABASE_URL=postgresql://monitorame:monitorame@localhost:15432/monitorame
LOG_DATABASE_URL=postgresql://monitorame:monitorame@localhost:15432/monitorame
DATABASE_SSLMODE=disable
LOG_DATABASE_SSLMODE=disable
LOG_LEVEL=INFO

# PostgreSQL local iniciado por compose.yaml. Ao alterar usuario, senha, porta
# ou nomes dos databases, atualize tambem as duas URLs acima.
POSTGRES_USER=monitorame
POSTGRES_PASSWORD=monitorame
POSTGRES_DB=monitorame
POSTGRES_PORT=15432
POSTGRES_VOLUME_NAME=monitorame_pipeline_api_postgres_data
API_PORT=8000
API_IMAGE=pipeline-api:local
MIGRATION_IMAGE=pipeline-migrate:local
PNCP_COLLECTION_IMAGE=pncp-worker-coleta:local
PNCP_NORMALIZATION_IMAGE=pncp-worker-normalizacao:local
PNCP_ENRICHMENT_IMAGE=pncp-worker-enriquecimento:local
MATCHING_NLP_IMAGE=matching-nlp-worker:local
MATCHING_INTERNAL_API_TOKEN=
MATCHING_NLP_MEMORY_LIMIT=2g
MATCHING_NLP_CPUS=1.50
MATCHING_NLP_CACHE_VOLUME=monitorame_matching_nlp_hf_cache
NLP_EMBEDDING_MODEL=intfloat/multilingual-e5-small
# SHA fixado do modelo validado; alteracoes aqui criam uma nova model_version.
NLP_EMBEDDING_REVISION=fd1525a9fd15316a2d503bf26ab031a61d056e98
NLP_EMBEDDING_DEVICE=cpu
NLP_EMBEDDING_IDLE_SECONDS=5
NLP_WORKER_IDLE_EXIT_SECONDS=5
NLP_MODEL_IDLE_UNLOAD_SECONDS=60
NLP_EMBEDDING_MAX_ATTEMPTS=5
NLP_RETRIEVAL_TOP_K=100

TCE_CE_BASE_URL=https://api-dados-abertos.tce.ce.gov.br/sim
IBGE_LOCALIDADES_BASE_URL=https://servicodados.ibge.gov.br/api/v1/localidades
OPENCNPJ_BASE_URL=https://api.opencnpj.org
PNCP_BASE_URL=https://pncp.gov.br/api/consulta
# Base pública de integração para GET de detalhe, itens e documentos.
PNCP_ENRICHMENT_BASE_URL=https://pncp.gov.br/api/pncp
PNCP_ENRICHMENT_TTL_HOURS=24
PNCP_ENRICHMENT_MAX_ITEM_PAGES=100
PNCP_ENRICHMENT_WORKERS=3
PNCP_CONNECT_TIMEOUT_SECONDS=10
PNCP_READ_TIMEOUT_SECONDS=30
PNCP_OVERLAP_MINUTES=5
# Inclui a chamada inicial. Falhas transitórias são reagendadas pelo PostgreSQL.
PNCP_MAX_ATTEMPTS=5
PNCP_RETRY_INITIAL_SECONDS=2
PNCP_RETRY_MAX_SECONDS=60
PNCP_REQUEST_INTERVAL_SECONDS=2
PNCP_RATE_LIMIT_REQUESTS_PER_SECOND=2
PNCP_CONCURRENCY_INITIAL=2
PNCP_CONCURRENCY_MAX=5
PNCP_CIRCUIT_FAILURE_THRESHOLD=5
PNCP_CIRCUIT_COOLDOWN_SECONDS=60
PNCP_CIRCUIT_HALF_OPEN_MAX_CALLS=1
PNCP_LATENCY_DEGRADE_SECONDS=5
PNCP_WORKER_IDLE_SECONDS=1
UF_PADRAO=CE

CODIGO_MUNICIPIO_TCE_PADRAO=010
